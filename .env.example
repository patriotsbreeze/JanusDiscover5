# JanusDiscover Environment Variables
# Copy this file to .env and fill in your values

# ── LLM (required for real-mode literature review) ──────────────────────────
# Only the key for the provider you choose needs to be set.
# Keys can also be entered directly in the web UI (stored in your browser).

ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Ollama: no key needed — set base URL if not running on localhost:11434
OLLAMA_BASE_URL=http://localhost:11434/v1

# Default model override (used when no model is specified in the UI).
# If unset, sensible defaults are chosen per provider.
LLM_MODEL=

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS (comma-separated list of allowed frontend origins) ──────────────────
# For production set this to your actual domain
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── File storage (relative to backend working directory) ─────────────────────
STATIC_DIR=static
FIGURES_DIR=static/figures
MANUSCRIPT_DIR=static/manuscripts

# ── Dataset cache (downloaded ZINC/ChEMBL SMILES files stored here) ──────────
DATASET_CACHE_DIR=/tmp/janusdiscover_datasets
