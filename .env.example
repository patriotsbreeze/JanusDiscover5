# JanusDiscover Environment Variables
# Copy this file to .env and fill in your values

# ── LLM (required for real-mode literature review) ──────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Which Claude model to use for literature synthesis (default: claude-opus-4-7)
LLM_MODEL=claude-opus-4-7

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS (comma-separated list of allowed frontend origins) ──────────────────
# For production set this to your actual domain
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── File storage (relative to backend working directory) ─────────────────────
STATIC_DIR=static
FIGURES_DIR=static/figures
MANUSCRIPT_DIR=static/manuscripts

# ── Dataset cache (downloaded ZINC/ChEMBL SMILES files stored here) ──────────
DATASET_CACHE_DIR=/tmp/janusdiscover_datasets
