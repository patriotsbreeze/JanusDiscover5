# JanusDiscover Environment Variables
# Copy this file to .env and fill in values

# Anthropic API key for LLM literature review (real mode only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server settings
HOST=0.0.0.0
PORT=8000

# File storage paths (relative to backend working directory)
STATIC_DIR=static
FIGURES_DIR=static/figures
MANUSCRIPT_DIR=static/manuscripts

# CORS origin for frontend
FRONTEND_URL=http://localhost:3000
