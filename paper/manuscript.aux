\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces JanusDiscover end-to-end workflow. \textbf  {(A)}~User enters the protein target name and selects real or mock mode. \textbf  {(B)}~AI-assisted literature review returns existing therapies, PDB entries, known active counts, and a recommended screening strategy. \textbf  {(C)}~Researcher approves or modifies the strategy; virtual screening executes and returns top-20 hits with validation figures. \textbf  {(D)}~Optional molecular dynamics simulation of the top hit; RMSD, RMSF, $R_g$, energy, SASA, and violin plots are generated. \textbf  {(E)}~Platform exports all figures and a methods description for direct use in publications.}}{19}{figure.caption.33}\protected@file@percent }
\newlabel{fig:workflow}{{1}{19}{JanusDiscover end-to-end workflow. \textbf {(A)}~User enters the protein target name and selects real or mock mode. \textbf {(B)}~AI-assisted literature review returns existing therapies, PDB entries, known active counts, and a recommended screening strategy. \textbf {(C)}~Researcher approves or modifies the strategy; virtual screening executes and returns top-20 hits with validation figures. \textbf {(D)}~Optional molecular dynamics simulation of the top hit; RMSD, RMSF, $R_g$, energy, SASA, and violin plots are generated. \textbf {(E)}~Platform exports all figures and a methods description for direct use in publications}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces LBDD virtual screening results for PKA (MUV-548) on the MUV benchmark. \textbf  {(a)}~ROC curve (five-fold cross-validation); shaded band shows $\pm 1\,\sigma $ over folds (AUC-ROC $= 0.926$). \textbf  {(b)}~Enrichment curve; horizontal dashed line indicates random baseline (EF~$= 1$). \textbf  {(c)}~Score distributions for actives (blue) and MUV decoys (red); partial overlap reflects the topological similarity of MUV decoys. \textbf  {(d)}~Metrics summary bar chart (AUC-ROC $= 0.926$, BEDROC $= 0.743$, EF$_{1\%} = 31.9\times $, EF$_{5\%} = 13.9\times $).}}{20}{figure.caption.34}\protected@file@percent }
\newlabel{fig:lbdd}{{2}{20}{LBDD virtual screening results for PKA (MUV-548) on the MUV benchmark. \textbf {(a)}~ROC curve (five-fold cross-validation); shaded band shows $\pm 1\,\sigma $ over folds (AUC-ROC $= 0.926$). \textbf {(b)}~Enrichment curve; horizontal dashed line indicates random baseline (EF~$= 1$). \textbf {(c)}~Score distributions for actives (blue) and MUV decoys (red); partial overlap reflects the topological similarity of MUV decoys. \textbf {(d)}~Metrics summary bar chart (AUC-ROC $= 0.926$, BEDROC $= 0.743$, EF$_{1\%} = 31.9\times $, EF$_{5\%} = 13.9\times $)}{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces SBDD virtual screening results for ABL1 kinase. \textbf  {(a)}~Docking score distributions for actives (blue) and decoys (red); separation confirms enrichment of true binders at negative scores. \textbf  {(b)}~SBDD ROC curve. \textbf  {(c)}~Redocking RMSD histogram with \SI {2}{\angstrom } success cutoff (dashed red); success rate indicated. \textbf  {(d)}~Enrichment curve. \textbf  {(e)}~Top-20 hit docking scores (bar chart).}}{21}{figure.caption.35}\protected@file@percent }
\newlabel{fig:sbdd}{{3}{21}{SBDD virtual screening results for ABL1 kinase. \textbf {(a)}~Docking score distributions for actives (blue) and decoys (red); separation confirms enrichment of true binders at negative scores. \textbf {(b)}~SBDD ROC curve. \textbf {(c)}~Redocking RMSD histogram with \SI {2}{\angstrom } success cutoff (dashed red); success rate indicated. \textbf {(d)}~Enrichment curve. \textbf {(e)}~Top-20 hit docking scores (bar chart)}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Molecular dynamics simulation of ABL1 kinase (PDB 2HYY chain~A, \SI {10}{\nano \second }, AMBER ff14SB + TIP3P, 70\,049 atoms, NVIDIA GTX~1080 OpenCL). \textbf  {(a)}~C$\alpha $ RMSD vs.\ time (mean $1.76$\,\r A, max $2.51$\,\r A). \textbf  {(b)}~Per-residue C$\alpha $ RMSF; P-loop (248--259) and activation loop (380--385) are the most flexible regions. \textbf  {(c)}~Radius of gyration vs.\ time (mean $19.44 \pm 0.11$\,\r A). \textbf  {(d)}~Potential energy vs.\ time (kJ~mol$^{-1}$). \textbf  {(e)}~Solvent-accessible surface area vs.\ time (mean $14{,}215$\,\r A$^{2}$). \textbf  {(f)}~Binding-site C$\alpha $ RMSD (residues within 5\,\r A{} of co-crystal imatinib; mean $0.76$\,\r A), confirming active-site structural stability.}}{22}{figure.caption.36}\protected@file@percent }
\newlabel{fig:md}{{4}{22}{Molecular dynamics simulation of ABL1 kinase (PDB 2HYY chain~A, \SI {10}{\nano \second }, AMBER ff14SB + TIP3P, 70\,049 atoms, NVIDIA GTX~1080 OpenCL). \textbf {(a)}~C$\alpha $ RMSD vs.\ time (mean $1.76$\,\AA , max $2.51$\,\AA ). \textbf {(b)}~Per-residue C$\alpha $ RMSF; P-loop (248--259) and activation loop (380--385) are the most flexible regions. \textbf {(c)}~Radius of gyration vs.\ time (mean $19.44 \pm 0.11$\,\AA ). \textbf {(d)}~Potential energy vs.\ time (kJ~mol$^{-1}$). \textbf {(e)}~Solvent-accessible surface area vs.\ time (mean $14{,}215$\,\AA $^{2}$). \textbf {(f)}~Binding-site C$\alpha $ RMSD (residues within 5\,\AA {} of co-crystal imatinib; mean $0.76$\,\AA ), confirming active-site structural stability}{figure.caption.36}{}}
